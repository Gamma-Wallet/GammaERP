<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: missing XML comments are allowed; documentation is kept where it adds meaning.
         CA1711: "Permission" is a domain term (Permission, RolePermission), not a type-name suffix. -->
    <NoWarn>$(NoWarn);CS1591;CA1711</NoWarn>
    <Company>Gamma Wallet Ltd</Company>
    <Product>Gamma ERP</Product>
    <Copyright>Copyright (c) Gamma Wallet Ltd and contributors</Copyright>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <Version>0.1.0</Version>
  </PropertyGroup>
</Project>
