# Copy to .env (never committed) and set real values.
# The image version from ghcr.io/gamma-wallet: gamma (the latest Gamma release) or an exact one such as 0.1.0-gamma.
ERP_TAG=gamma
POSTGRES_DB=gamma_erp
POSTGRES_USER=gamma_erp
POSTGRES_PASSWORD=change-me
DB_PORT=5433
# The screens and the API on one address (the web container); only this port is published.
WEB_PORT=8090
# The screens' sign-in return address: the address people open, then /signed-in.
AUTH_REDIRECT_URI=https://erp.example.com/signed-in
# true unless a proxy in front ends TLS; then also FORWARDED_HEADERS=true (only when the proxy is the API's only way in).
AUTH_REQUIRE_HTTPS=true
# The MCP endpoint's public address (Claude connects to it): this host's address followed by /mcp.
MCP_RESOURCE=https://erp.example.com/mcp
# true: the erp container publishes no port, so the web container is the API's only way in and its X-Forwarded-* headers are trusted.
FORWARDED_HEADERS=true
# The token keys (PFX files in ./certs). Without them every restart signs everyone out.
AUTH_SIGNING_CERTIFICATE=/certs/signing.pfx
AUTH_ENCRYPTION_CERTIFICATE=/certs/encryption.pfx
AUTH_CERTIFICATE_PASSWORD=change-me
# The largest file accepted, in bytes (files and sign-in keys are kept in the erp-data volume, /data).
FILES_MAX_BYTES=10485760
# E-mail (documents sent as PDF). Leave MAIL_HOST empty to keep e-mail off.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
# StartTls (default) or SslOnConnect; None only for a local test server.
MAIL_SECURITY=StartTls
MAIL_USER=erp@example.com
MAIL_PASSWORD=change-me
MAIL_FROM=erp@example.com
