# The screens and the API on one address: the API's paths go to the erp container, everything else is the Angular build.
# TLS is ended by the host's reverse proxy in front (or by Caddy itself if this file is changed to name the domain).
{
	admin off
	auto_https off
	servers {
		# The port is published on 127.0.0.1 only: what connects is the host's proxy, and its X-Forwarded-For names the client.
		trusted_proxies static private_ranges
	}
}

:8080 {
	encode zstd gzip

	@api path /api/* /account/* /connect/* /.well-known/* /health
	handle @api {
		reverse_proxy {$ERP_UPSTREAM} {
			header_up X-Forwarded-For {client_ip}
		}
	}

	# The MCP server (Claude): passed on as it streams, without compression.
	@mcp path /mcp /mcp/*
	handle @mcp {
		reverse_proxy {$ERP_UPSTREAM} {
			header_up X-Forwarded-For {client_ip}
			flush_interval -1
		}
	}

	handle {
		root * /srv
		# The hashed bundles never change; everything else (index.html for every screen's address) comes fresh, so a new build is seen at once.
		@hashed path_regexp hashed -[0-9A-Z]{8,}\.(js|css)$
		@fresh not path_regexp -[0-9A-Z]{8,}\.(js|css)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header @fresh Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
}
